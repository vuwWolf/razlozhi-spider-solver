{
  "appId": "ru.razlozhi.spidersolver",
  "productName": "Spider Solver",
  "asar": true,
  "files": [
    "src/**/*",
    "public/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "artifactName": "Spider-Solver-${version}-setup-${arch}.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "artifactName": "Spider-Solver-${version}-mac-${arch}.${ext}",
    "category": "public.app-category.games",
    "darkModeSupport": true,
    "identity": null,
    "hardenedRuntime": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
